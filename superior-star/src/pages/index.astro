---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import "../styles/index.css";

---

<script>
  import "../scripts/scroll.js";
  import loadIcons from "../scripts/load-icons.js";
  loadIcons();
</script>

<!DOCTYPE html>
<html lang="es">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css"
    />
    <style>
      body {
        font-family:
          "Inter",
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          Roboto,
          Oxygen,
          Ubuntu,
          Cantarell,
          "Open Sans",
          "Helvetica Neue",
          sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
    </style>
  </head>
  <body>
    <Header />

    <!-- HERO -->
    <section class="hero">
      <img
        src="/cap1.png"
        alt="Miguel Ángel Ledesma"
        class="profile-img"
      />
      <h1 class="hero-title" data-i18n="hero.greeting">
        ¡Hola, soy Miguel Ángel!
      </h1>
      <h3 class="hero-subtitle" data-i18n="hero.subtitle">
        Desarrollador Web Full-Stack and Rpa Developer. De Sevilla, España. Graduado en Diseño de
        Aplicaciones WEB
      </h3>

      <div class="buttons-container">
        <a href="https://github.com/MALR07" class="button" data-i18n="hero.viewProjects">
          <!-- Icono GitHub -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            fill="currentColor"
            viewBox="0 0 24 24"
            style="margin-right:0.5rem;"
          >
            <path
              d="M12 0C5.372 0 0 5.372 0 12c0 5.303 3.438 9.8 8.205 11.387.6.113.82-.26.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.334-1.756-1.334-1.756-1.09-.745.082-.73.082-.73 1.205.085 1.84 1.237 1.84 1.237 1.07 1.835 2.807 1.305 3.492.997.108-.775.418-1.305.76-1.605-2.665-.305-5.467-1.332-5.467-5.93 0-1.31.467-2.38 1.236-3.22-.124-.304-.536-1.527.116-3.176 0 0 1.008-.322 3.3 1.23a11.49 11.49 0 0 1 3-.404c1.02.004 2.047.138 3 .404 2.29-1.552 3.296-1.23 3.296-1.23.655 1.65.243 2.873.12 3.176.77.84 1.234 1.91 1.234 3.22 0 4.61-2.807 5.623-5.48 5.922.43.37.823 1.096.823 2.21 0 1.595-.015 2.883-.015 3.273 0 .32.216.694.825.576C20.565 21.795 24 17.298 24 12c0-6.628-5.372-12-12-12z"
            ></path>
          </svg>
          GitHub
        </a>

        <a href="https://www.linkedin.com/in/miguel-angel-ledesma-rodriguez" class="button" data-i18n="hero.experience">
          <!-- Icono LinkedIn -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            fill="currentColor"
            viewBox="0 0 24 24"
            style="margin-right:0.5rem;"
          >
            <path
              d="M20.447 20.452H17.24V14.87c0-1.33-.025-3.043-1.852-3.043-1.854 0-2.136 1.445-2.136 2.938v5.688H9.068V9h3.105v1.561h.045c.433-.82 1.492-1.682 3.067-1.682 3.279 0 3.882 2.16 3.882 4.97v6.603zM5.337 7.433a1.798 1.798 0 1 1 0-3.595 1.798 1.798 0 0 1 0 3.595zM6.839 20.452H3.835V9h3.004v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.228.792 24 1.771 24h20.451C23.2 24 24 23.228 24 22.271V1.729C24 .774 23.2 0 22.225 0z"
            ></path>
          </svg>
          LinkedIn
        </a>

        <a
          href="mailto:mledesmarodriguez04@gmail.com"
          class="button"
          data-i18n="hero.contact"
        >
          <!-- Icono de mensaje -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              d="M12 12.713l11.985-7.713H0L12 12.713zm0 2.574l-12-7.713V20h24V7.574l-12 7.713z"
            ></path>
          </svg>
          mledesmarodriguez04@gmail.com
        </a>
      </div>
    </section>
    <main class="container">
      <!-- EXPERIENCIA -->
      <section id="experiencia" class="experience-section">
        <h2 class="section-title">
          <svg
            class="section-icon"
            xmlns="http://www.w3.org/2000/svg"
            width="28"
            height="28"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              d="M10 2h4a2 2 0 0 1 2 2v2h4v16H4V6h4V4a2 2 0 0 1 2-2zm0 2v2h4V4h-4zm-4 4v12h12V8H6z"
            ></path>
          </svg>
          <span data-i18n="experience.title">Experiencia Laboral</span>
        </h2>

        <div class="experience-list">
          <div class="experience-card" data-i18n="experience.job1">
            <!-- Empresa centrada -->
            <h2 class="experience-company">CodeArts Solutions</h2>

            <div class="experience-row">
              <!-- Izquierda: puesto y fecha -->
              <div class="experience-left">
                <h3
                  class="experience-position"
                  data-i18n="experience.job1.title"
                >
                  Desarrollador Web Full-Stack Prácticas
                </h3>
                <span
                  class="experience-period"
                  data-i18n="experience.job1.period"
                >
                  Febrero 2025 - Junio 2025
                </span>
              </div>

              <!-- Derecha: descripción -->
              <div class="experience-right">
                <p data-i18n="experience.job1.description">
                  Fueron mis primeras prácticas como Desarrollador Web
                  Full-Stack, donde aprendí muchísimo. Creamos un proyecto
                  llamado Vuela 21 y lo desarrollamos desde cero con Symfony y
                  Angular.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- PROYECTOS -->
      <main class="container">
        <section id="proyectos" class="projects">
          <h2 class="section-title">
            <span class="section-icon">&lt;/&gt;</span> <span data-i18n="projects.title">Proyectos</span>
          </h2>

          <div class="projects-grid">
            <!-- Proyecto 1 -->
            <article class="project-card project-left">
              <div class="project-image-wrapper">
                <img
                  src="/cap3.png"
                  alt="Web TFG"
                  class="project-image"
                />
              </div>
              <div class="project-content">
                <h3 data-i18n="projects.webTFG.title">Bar Pepin Web (TFG)</h3>
                <p data-i18n="projects.webTFG.description" class="project-description">
                  Aplicación web full-stack para gestión de platos y reservas de
                  los mismos desarrollada con React, Node.js, y PostgreSQL.
                </p>
                <div class="project-tech">
                  <span
                    ><i class="devicon-react-original colored"></i> React</span
                  >
                  <span
                    ><i class="devicon-nodejs-plain colored"></i> Node.js</span
                  >
                  <span><i class="devicon-express-original"></i> Express</span>
                  <span
                    ><i class="devicon-typescript-plain colored"></i> TypeScript</span
                  >
                  <span
                    ><i class="devicon-tailwindcss-plain colored"></i> Tailwind</span
                  >
                  <span
                    ><i class="devicon-postman-plain colored"></i> Postman</span
                  >
                  <span
                    ><i class="devicon-postgresql-plain colored"
                    ></i>PostgreSQL</span
                  >
                  <span
                    ><i class="devicon-javascript-plain colored"></i> JWT</span
                  >
                  <span><i class="devicon-html5-plain colored"></i> HTML</span>
                </div>
                <div class="project-links">
                  <a href="https://barpepin.netlify.app/" target="_blank" class="button" data-i18n="projects.webTFG.viewPage">Ver Pagina</a>
                  <a href="https://docs.google.com/presentation/d/1VtAWp7XyQicqxx1la7BSJ67Tg-uL8LLQv1vqCUMIJnA/edit?slide=id.p#slide=id.p" class="button" data-i18n="projects.webTFG.viewDemo">Ver Demo</a>
                </div>
              </div>
            </article>

            <!-- Proyecto 2 -->
            <article class="project-card project-right">
              <div class="project-image-wrapper">
                <img
                  src="/cap 1.png"
                  alt="Web Vuela 21"
                  class="project-image"
                />
              </div>
              <div class="project-content">
                <h3 data-i18n="projects.webVuela21.title">Vuela 21</h3>
                <p data-i18n="projects.webVuela21.description" class="project-description">
                  Durante mis prácticas en Codearts Solutions, desarrollamos
                  desde cero una aplicación de paquetería. Inicialmente no
                  contábamos con mucha información sobre cómo querían el
                  producto, pero logramos llevarlo a cabo en el tiempo limitado
                  que teníamos, dejando la aplicación completamente funcional.
                </p>
                <div class="project-tech">
                  <span><i class="devicon-symfony-original"></i> Symfony</span>
                  <span
                    ><i class="devicon-angularjs-plain colored"></i> Angular</span
                  >
                  <span
                    ><i class="devicon-tailwindcss-plain colored"></i> Tailwind</span
                  >
                  <span
                    ><i class="devicon-postman-plain colored"></i> Postman</span
                  >
                  <span
                    ><i class="devicon-typescript-plain colored"></i> TypeScript</span
                  >
                  <span
                    ><i class="devicon-postgresql-plain colored"></i> PostgreSQL</span
                  >
                  <span
                    ><i class="devicon-javascript-plain colored"></i> JWT</span
                  >
                  <span><i class="devicon-html5-plain colored"></i> HTML</span>
                </div>
                <div class="project-links">
                  <a
                    href="https://docs.google.com/presentation/d/175w9g3yC1XDWH9VL1SDxARW6R5n00rDRbxYhr5tRveQ/edit?hl=es&slide=id.p#slide=id.p"
                    class="button" data-i18n="projects.webVuela21.viewPresentation">Ver Presentación</a
                  >
                </div>
              </div>
            </article>
            <!-- Proyecto 3 -->
            <article class="project-card project-left">
              <div class="project-image-wrapper">
                <img
                  src="/logo EXAM BOT.png"
                  alt="RPA Exam BOT DISCORD"
                  class="project-image"
                />
              </div>
              <div class="project-content">
                <h3 data-i18n="projects.rpaBot.title">RPA Exam BOT DISCORD</h3>
                <p data-i18n="projects.rpaBot.description" class="project-description">
                  Se trata de una automatizacion de un bot de Discord para realizar la creacion de examenes o mensajes donde dependiendo del tipo te manda un formaluario dodne lo rellenas lo que quieres dia y hora a la que se hara, añadiendo reaciones para contavilizar quien va a asistir. Se ha desarrollado con N8n, con Apis de Airtable y Discord.
                </p>
                <div class="project-tech">
                  <span class="tech-pill"><i class="devicon-javascript-plain colored"></i><span class="tech-label">JavaScript</span></span>
                  <span class="tech-pill"><span class="tech-svg" data-src="https://cdn.simpleicons.org/n8n"></span><span class="tech-label"> n8n</span></span>
                  <span class="tech-pill"><span class="tech-svg" data-src="https://cdn.simpleicons.org/airtable"></span><span class="tech-label"> Airtable</span></span>
                  <span class="tech-pill"><span class="tech-svg" data-src="https://cdn.simpleicons.org/discord"></span><span class="tech-label"> Discord</span></span>
                </div>
                <div class="project-links">
                  <a
                    href="https://github.com/MALR07/RPA-Exam_BOT_DISCORD_MALR"
                    class="button" data-i18n="projects.rpaBot.viewCode">Codigo</a
                  >
                </div>
              </div>
            </article>
             <!-- Proyecto 4 -->
            <article class="project-card project-right">
              <div class="project-image-wrapper">
                <img
                  src="/pisitos.png"
                  alt="Pisitos (Travel and Activities)"
                  class="project-image"
                />
              </div>
              <div class="project-content">
                <h3 data-i18n="projects.pisitos.title">Pisitos (Travel and Activities)</h3>
                <p data-i18n="projects.pisitos.description" class="project-description">
                  Proyecto académico "Pisitos", enfocado en la monitorización, extracción y consolidación de ofertas inmobiliarias desde la plataforma Idealista de forma 100% desatendida en Power Automate. El objetivo principal es eliminar la carga operativa manual de búsqueda de inmuebles, procesando criterios parametrizados y distribuyendo informes automatizados por correo electrónico.
                </p>
                <div class="project-tech">
                  <span class="tech-pill"><span class="tech-svg" data-src="https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/microsoft-power-automate.svg"></span><span class="tech-label">Power Automate</span></span>
                  <span class="tech-pill"><span class="tech-svg" data-src="https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/microsoft-excel.svg"></span><span class="tech-label">Excel</span></span>
                  <span class="tech-pill"><span class="tech-svg" data-src="https://cdn.simpleicons.org/gmail"></span><span class="tech-label">Gmail</span></span>
                </div>
                <div class="project-links">
                  <a
                    href="https://github.com/MALR07/Pisitos_TRAVEL_MALR"
                    class="button" data-i18n="projects.pisitos.viewCode">Codigo</a
                  >
                </div>
              </div>
            </article>
              <!-- Proyecto 5 -->
            <article class="project-card project-left">
              <div class="project-image-wrapper">
                <img
                  src="/aegisIA.png"
                  alt="Aegis AI Documents"
                  class="project-image"
                />
              </div>
              <div class="project-content">
                <h3 data-i18n="projects.aegis.title">Aegis AI Documents</h3>
                <p data-i18n="projects.aegis.description" class="project-description"></p>
                <div class="project-tech">
                  <span class="tech-pill"><span class="tech-svg" data-src="https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/microsoft-power-automate.svg"></span><span class="tech-label">Power Automate</span></span>
                  <span class="tech-pill"><span class="tech-svg" data-src="https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/microsoft-sharepoint.svg"></span><span class="tech-label">SharePoint</span></span>
                  <span class="tech-pill"><img src="/chatgpt.svg" alt="ChatGPT" style="width: 20px; height: 20px; filter: brightness(0) invert(1);" /><span class="tech-label">ChatGPT</span></span>
                </div>
                <div class="project-links">
                  <a
                    href="https://github.com/MALR07/Aegis-AI-Documents"
                    class="button" data-i18n="projects.aegis.viewCode">Codigo</a
                  >
                  <a
                    href="https://youtu.be/5eqmLY37gW8"
                    class="button" data-i18n="projects.aegis.viewVideo">Video</a
                  >
                  <a
                    href="https://canva.link/354st0i89jl395o"
                    class="button" data-i18n="projects.aegis.viewPower">Presentación</a
                  >
                </div>
              </div>
            </article>
             <!-- Proyecto 6 -->
            <article class="project-card project-right">
              <div class="project-image-wrapper">
                <img
                  src="/Eva1.png"
                  alt="Evangelion of gamers"
                  class="project-image"
                />
              </div>
              <div class="project-content">
                <h3 data-i18n="projects.eva.title">Evangelion of Gamers</h3>
                <p data-i18n="projects.eva.description" class="project-description">
                  Evangelion of Gamers es una aplicación web full-stack pensada por y para amantes de los videojuegos. Permite llevar un control detallado de tu colección personal de juegos, 
                  explorar el catálogo global y consultar logros a través de la integración con RAWG API.
                </p>
                <div class="project-tech">
                  <span class="tech-pill"><i class="devicon-react-original colored"></i><span class="tech-label">React</span></span>
                  <span class="tech-pill"><i class="devicon-postgresql-plain colored"></i><span class="tech-label">PostgreSQL</span></span>
                  <span class="tech-pill"><i class="devicon-javascript-plain colored"></i><span class="tech-label">JWT</span></span>
                  <span class="tech-pill"><i class="devicon-html5-plain colored"></i><span class="tech-label">HTML</span></span>
                </div>
                <div class="project-links">
                  <a
                    href="https://github.com/MALR07/Evangelion_of_Gamers"
                    class="button" data-i18n="projects.eva.viewCode">Codigo</a
                  >
                  <a
                    href="https://evangeliongamers.netlify.app/"
                    class="button" data-i18n="projects.eva.viewPage">Ver Pagina</a
                  >
                </div>
              </div>
            </article>
          </div>
        </section>
       
        
        <!-- SOBRE MI -->
        <section id="sobre-mi" class="about">
          <img
            src="/cap2.jpg"
            alt="Miguel Ángel Ledesma"
            class="about-img"
          />
          <div class="about-content" data-i18n="about">
            <h2 data-i18n="about.title">
              <span class="section-icon">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  width="30"
                  height="30"
                  fill="#8B5CF6"
                >
                  <path
                    d="M12 12c2.7 0 5-2.3 5-5s-2.3-5-5-5-5 2.3-5 5 2.3 5 5 5zm0 2c-3.3 0-10 1.7-10 5v3h20v-3c0-3.3-6.7-5-10-5z"
                  ></path>
                </svg>
              </span>
              Sobre Mí
            </h2>
            <p id="about-opportunities" data-i18n="about.opportunities" class="about-paragraph">
              Hola, soy <span class="about-name">Miguel Ángel Ledesma</span>, un <span class="about-role">Programador Web y RPA Developer</span>, graduado en <span class="accent-red">Diseño de Aplicaciones Web (DAW)</span>. Actualmente, estoy <span class="about-phrase">desarrollando aplicaciones y automatizaciones</span> para seguir formándome y mejorar mis habilidades en el <span class="about-phrase">desarrollo web y automatización de procesos</span>.
            </p>
            <p id="about-technologies" data-i18n="about.technologies" class="about-paragraph">
              Tengo muchas ganas de demostrar mis habilidades y dar mi creatividad un paso adelante. <span class="about-residence">Resido en Sevilla</span>, concretamente en un pueblo llamado <span class="about-town">Morón de la Frontera</span>, <span class="accent-orange">España</span>. Soy una persona sociable, perfeccionista y disciplinada.
            </p>
          </div>
        </section>
      </main>
      <Footer />
    </main>
  </body>
</html>
